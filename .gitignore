# окружение и веса
.venv/
models/
# кэш и Python, которые uv качает при установке
.uv/
.uv-cache/
.python/
__pycache__/
*.pyc

# резервные копии исходников на случай порчи антивирусом
.backup/
# метка фоновой проверки: какие пакеты чинить при следующем запуске
.broken_packages

# личное: записи разговоров и разборы собеседований
расшифровки/
мок-собесы/
настройки.json
настройки.json.tmp
настройки.json.bad
ошибка.log

# личные дополнения к общим словарям: компания, имена, свои словечки
*.local.txt
*.local.yaml

# банки вопросов содержат подготовку под конкретные компании
вопросы/*.yaml
!вопросы/пример.yaml
!вопросы/Общие вопросы.yaml
# готовые банки по ролям, идут вместе с программой
!вопросы/Пробный собес.yaml
!вопросы/Python-разработчик.yaml
!вопросы/Frontend-разработчик.yaml
!вопросы/Тестировщик QA.yaml
!вопросы/Аналитик данных.yaml
!вопросы/ML-инженер.yaml
!вопросы/Менеджер проектов в IT.yaml

